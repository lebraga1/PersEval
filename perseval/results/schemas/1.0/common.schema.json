{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perseval.org/schemas/result-bundle/1.0/common.schema.json",
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "run_id": {
      "type": "string",
      "minLength": 40,
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 40
    },
    "submission_id": {
      "type": "string",
      "minLength": 40,
      "pattern": "^sub_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 40
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:artifacts/)?[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "scoring_rule": {
      "const": "perseval.macro-f1.v1"
    }
  }
}
